{
  "manifest_version": 3,
  "name": "ChatGPT Thread Lite",
  "description": "Reduce long ChatGPT thread lag by parking older turns and applying browser rendering containment.",
  "version": "0.1.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": ["src/content.css"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Thread Lite",
    "default_popup": "src/popup.html"
  }
}
